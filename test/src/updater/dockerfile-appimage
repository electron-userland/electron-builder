FROM buildpack-deps:jammy-curl

ENV DEBIAN_FRONTEND=noninteractive

# apt-get update + install, retried: Ubuntu mirror nodes can be out of sync mid security-update (see script)
COPY test/src/updater/apt-install-retry.sh /usr/local/bin/apt-install-retry

# Enable universe repo to get legacy libraries
RUN apt-install-retry software-properties-common && \
    add-apt-repository universe && \
    rm -rf /var/lib/apt/lists/*

# Install required libraries for AppImages and legacy binaries
RUN apt-install-retry \
    fuse3 \
    libfuse2 \
    libasound2-dev \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    x11-utils \
    xvfb \
    file \
    ruby \
    curl \
    unzip \
    ca-certificates \
    zlib1g-dev \
    file \
    xvfb

RUN apt-install-retry python3.11 python3-setuptools make gcc g++

RUN apt-install-retry libvips-dev libglib2.0-dev pkg-config

ENV PYTHON=/usr/bin/python3.11

# Create fuse mount permissions
RUN echo "user_allow_other" >> /etc/fuse.conf

# Allow AppImages to run without sudo (needed for fuse)
RUN ln -s /usr/bin/fuse3 /usr/bin/fuse || true

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
RUN apt-get install -y nodejs
RUN npm --silent install --global --depth 0 pnpm corepack \
  && corepack enable

ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/lib/pkgconfig
ENV CFLAGS="-I/usr/include/glib-2.0 -I/usr/lib/aarch64-linux-gnu/glib-2.0/include"
ENV CPPFLAGS="-I/usr/include/glib-2.0 -I/usr/lib/aarch64-linux-gnu/glib-2.0/include"

WORKDIR /project
