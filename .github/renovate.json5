{
  extends: [
    "config:recommended",
    ":semanticCommitType(chore)",
    ":label(renovate)",
    ":prHourlyLimit2",
    ":prConcurrentLimit10",
    ":prNotPending",
    "group:recommended",
    "group:monorepos",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigests",
  ],
  npm: {
    extends: [
      ":noUnscheduledUpdates",
      ":maintainLockFilesWeekly",
      "security:minimumReleaseAgeNpm",
      "helpers:disableTypesNodeMajor",
    ],
    schedule: ["before 3am on the first day of the month"],
    packageRules: [
      {
        // oxlint and oxlint-tsgolint are version-coupled; keep the oxc tooling on one PR
        groupName: "oxc (oxlint, oxfmt)",
        matchPackageNames: [
          "oxlint",
          "oxlint-tsgolint",
          "oxfmt",
        ],
      },
    ],
  },
}
